            "accordion_row_RwGAVM": {
              "type": "_accordion-row",
              "name": "t:names.accordion_row",
              "settings": {
                "heading": "¿Puedo cambiar o devolver mi pedido?",
                "open_by_default": false
              },
              "blocks": {
                "text_YADF3Q": {
                  "type": "text",
                  "settings": {
                    "text": "<p>No realizamos cambios ni devoluciones, ya que cada producto se hace especialmente para vos. En caso de querer cambiar algo en tu pedido se cancelará la compra para que la vuelvas a hacer con los cambios correspondientes. <br/>Solo se aceptan reclamos por fallas de fabricación.</p>",
                    "width": "100%",
                    "max_width": "normal",
