              "type": "_accordion-row",
              "name": "t:names.accordion_dash_row",
              "settings": {
                "heading": "¿Cómo se hacen los envíos?",
                "open_by_default": false
              },
              "blocks": {
                "text_pgb8cW": {
                  "type": "text",
                  "name": "t:names.text",
                  "settings": {
                    "text": "<p>Realizamos envios a todo el país. Podes elegir correo o moto. Una vez realizada la compra, nos comunicamos por WhatsApp para que abones y coordines el envío. (Correo demora entre 2 a 5 días aprox.)</p>",
                    "width": "100%",
                    "max_width": "normal",
                    "alignment": "left",
