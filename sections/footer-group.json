            },
            "accordion_row_cTgAgA": {
              "type": "_accordion-row",
              "name": "t:names.accordion_dash_row",
              "settings": {
                "heading": "¿Cuánto tarda mi pedido?",
                "open_by_default": false
              },
              "blocks": {
                "text_kWpamn": {
                  "type": "text",
                  "name": "t:names.text",
                  "settings": {
                    "text": "<p>Todos los productos se fabrican a pedido en 5 a 7 días hábiles aproximadamente, estos tiempos pueden variar por lo que recomendamos consultar antes de comprar. Intentamos minimizar estos tiempos, pero tenelo en cuenta al comprar, ya que son productos 100% personalizados y artesanales.</p>",
                    "width": "100%",
                    "max_width": "normal",
                    "alignment": "left",
                    "type_preset": "custom",
                    "font": "var(--font-body--family)",
                    "font_size": "1rem",
