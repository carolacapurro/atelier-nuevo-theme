{{ 'midori-pre-compra.css' | asset_url | stylesheet_tag }}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=La+Belle+Aurore&family=Newsreader:ital,opsz,wght@0,6..72,300;0,6..72,400;0,6..72,500;1,6..72,300;1,6..72,400&family=Montserrat:wght@400;500;600;700&display=swap">

{%- liquid
  assign cuero_blocks = section.blocks | where: 'type', 'cuero'
  assign price_product = section.settings.price_product | default: product

  assign transfer_off = section.settings.transfer_discount | default: 10
  assign classic_off = section.settings.classic_discount | default: 20
  assign transfer_keep = 100 | minus: transfer_off
  assign classic_keep = 100 | minus: classic_off

  comment
    Precio "Diseño a tu medida" = precio del producto. "Selección clásica" = ese precio menos classic_discount %.
    Se muestra el precio con transferencia (menos transfer_discount %) y el precio de lista tachado.
  endcomment
  assign custom_list = price_product.price
  assign custom_pay = custom_list | times: transfer_keep | divided_by: 100
  assign classic_list = custom_list | times: classic_keep | divided_by: 100
  assign classic_pay = classic_list | times: transfer_keep | divided_by: 100

  comment
    Puntaje y cantidad: se leen de los metafields que Judge.me guarda en cada producto.
    Si no existen, se usan los valores de los ajustes de la sección.
  endcomment
  assign jm_rating = product.metafields.reviews.rating.value.rating
  assign jm_count = product.metafields.reviews.rating_count.value
  if jm_rating != blank and jm_count != blank
    assign rating_text = jm_rating | times: 1.0 | round: 1 | replace: '.', ','
    assign review_count = jm_count
  else
    assign rating_text = section.settings.rating
    assign review_count = section.settings.review_count
  endif

  assign customizer_url = section.settings.customizer_url
  if customizer_url == blank
    assign customizer_url = price_product.url | append: '?view=journal'
  endif
  assign classic_url = section.settings.classic_url | default: routes.collections_url
  assign crumb_url = section.settings.crumb_url | default: routes.collections_url
  assign model = section.settings.model | default: 'A5'
-%}

