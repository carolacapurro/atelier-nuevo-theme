<div class="mpc" id="mpc-{{ section.id }}">
<div class="pdp">
  <nav class="crumbs" aria-label="Ruta"><a href="{{ routes.root_url }}">Inicio</a><span>/</span><a href="{{ crumb_url }}">Midoris</a><span>/</span>Midori de cuero {{ model }}</nav>

  <div class="mpc-grid">
    <section aria-label="Fotos del producto">
      <div class="gal">
      <div class="stage" id="stage">
        {%- for block in cuero_blocks -%}
          {%- liquid
            assign img_src = ''
            if block.settings.image != blank
              assign img_src = block.settings.image | image_url: width: 760
            elsif block.settings.asset_file != blank
              assign img_src = block.settings.asset_file | asset_url
            endif
          -%}
          {%- if img_src != blank -%}
            <figure class="slide{% if forloop.first %} on{% endif %}" {{ block.shopify_attributes }}><img src="{{ img_src }}" alt="Midori en cuero {{ block.settings.name | downcase | escape }}" width="760" height="1013" loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"><figcaption>{{ block.settings.name }}</figcaption></figure>
          {%- endif -%}
        {%- endfor -%}
        <figure class="slide art"><svg class="art" viewBox="60 60 1090 1480" role="img" aria-label="Ilustración del Midori"><use href="#midori-art"/></svg><figcaption>Armalo a tu manera: cuero, cordón y dije</figcaption></figure>
        <button type="button" class="arrow prev" aria-label="Foto anterior"><svg class="i"><use href="#i-chevl"/></svg></button>
        <button type="button" class="arrow next" aria-label="Foto siguiente"><svg class="i"><use href="#i-chev"/></svg></button>
        <span class="count" aria-live="polite"><span id="cur">1</span> / <span id="tot">13</span></span>
      </div>
      <div class="thumbs" id="thumbs" role="tablist" aria-label="Elegir foto">
        {%- for block in cuero_blocks -%}
          <button type="button" class="thumb" role="tab" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}" aria-label="{{ block.settings.name | escape }}"><img alt="" width="120" height="160"></button>
        {%- endfor -%}
        <button type="button" class="thumb" role="tab" aria-selected="false" aria-label="Ilustración"><svg class="art" viewBox="60 60 1090 1480"><use href="#midori-art"/></svg></button>
      </div>
      </div>

      <figure class="postcard">
        <div>
          <blockquote>“{{ section.settings.review_quote }}”</blockquote>
          <div class="meta"><span class="stars" aria-label="5 de 5 estrellas"><svg class="i"><use href="#star"/></svg><svg class="i"><use href="#star"/></svg><svg class="i"><use href="#star"/></svg><svg class="i"><use href="#star"/></svg><svg class="i"><use href="#star"/></svg></span><span class="ver"><svg class="i"><use href="#i-check"/></svg>Compra verificada</span></div>
        </div>
        <div class="rule" aria-hidden="true"></div>
        <figcaption class="addr">
          <svg class="stamp" viewBox="0 0 100 120" aria-hidden="true"><use href="#stamp"/></svg>
          <svg class="pm2" viewBox="0 0 220 120" aria-hidden="true"><use href="#postmark"/></svg>
          <span>{{ section.settings.review_author }}</span><span>{{ section.settings.review_caption }}</span>
        </figcaption>
      </figure>
    </section>

    <section aria-label="Información y compra">
      <p class="eyebrow">Cuero natural · Hecho a mano</p>
      <h1>Midori de cuero {{ model }}</h1>
      <p class="sub">{{ section.settings.subtitle }}</p>
      <div class="ratingrow">
        <span class="stars" aria-hidden="true"><svg class="i"><use href="#star"/></svg><svg class="i"><use href="#star"/></svg><svg class="i"><use href="#star"/></svg><svg class="i"><use href="#star"/></svg><svg class="i"><use href="#star"/></svg></span>
        <b>{{ rating_text }}</b><a href="#resenas">({{ review_count }} reseñas)</a>
        <span class="faces" aria-hidden="true"><span>N</span><span>M</span><span>C</span><span>P</span></span>
      </div>

      <section class="process" aria-label="Nuestro proceso">
        <ol class="proc">
          <li><span class="num" aria-hidden="true">1</span><b>Elegí tu propio Midori</b></li>
          <li><span class="num" aria-hidden="true">2</span><b>Producción 5-7 días hábiles</b></li>
          <li><span class="num" aria-hidden="true">3</span><b>Coordinamos el envío por WhatsApp</b></li>
        </ol>
      </section>

      <h2 class="label">Elegí cómo adquirirlo</h2>
      <div class="choices" id="choices">
        <article class="choice a">
          <span class="tag">Hecho para vos</span>
          <div>
            <h3>Diseño <em>a tu medida</em></h3>
            <p>Cuero, cordón, esquinas, dije y grabado. Vista previa en vivo antes de confirmar.</p>
            <div class="chips"><span class="chip">Producción 5-7 días hábiles</span><span class="chip">Vista previa en vivo</span></div>
          </div>
          <div class="buy">
            <div class="price">Desde <s>{{ custom_list | money_without_trailing_zeros }}</s><b>{{ custom_pay | money_without_trailing_zeros }}</b><small>{{ transfer_off }}% off con transferencia</small></div>
            <a class="btn solid" href="{{ customizer_url }}">Personalizar <svg class="i"><use href="#i-arrow"/></svg></a>
          </div>
        </article>

        <article class="choice b">
          <span class="tag">Sale en 48 hs</span>
          <div>
            <h3>Selección <em>clásica</em></h3>
            <p>Combinaciones ya diseñadas, se despachan en 2 días hábiles o menos.</p>
            <div class="chips"><span class="chip">Despacho en 2 días hábiles</span><span class="chip">Sin personalizar</span></div>
          </div>
          <div class="buy">
            <div class="price">Desde <s>{{ classic_list | money_without_trailing_zeros }}</s><b>{{ classic_pay | money_without_trailing_zeros }}</b><small>{{ transfer_off }}% off con transferencia</small></div>
            <a class="btn mintline" href="{{ classic_url }}">Ver selección <svg class="i"><use href="#i-arrow"/></svg></a>
          </div>
        </article>
      </div>

      <p class="note"><svg class="i"><use href="#i-info"/></svg><span>El envío se calcula al finalizar la compra. Para regalos con fecha: la opción personalizada lleva 5-7 días hábiles de producción y la selección clásica se despacha en 2 días hábiles o menos.</span></p>

      <section class="proceso" aria-labelledby="proceso-t">
        <ol class="proceso-lista">
          <li class="proceso-head"><span class="proceso-dot" aria-hidden="true"></span>
            <div class="proceso-card oscura"><h3 id="proceso-t">¿Cómo es el proceso?<small>(simple)</small></h3></div>
          </li>
          <li><span class="proceso-dot" aria-hidden="true"></span>
            <div class="proceso-card" tabindex="0"><b>1 · Personalizá tu Midori y hacé la compra</b>
              <p>Elegís cuero, cordón, esquinas, dijes y grabado, y ves cómo queda antes de pagar.</p></div>
          </li>
          <li><span class="proceso-dot" aria-hidden="true"></span>
            <div class="proceso-card" tabindex="0"><b>2 · Lo hacemos a mano en 5 a 7 días hábiles</b>
              <p>En el taller cortamos el cuero, colocamos los ojalillos, grabamos tus letras y armamos tu Midori pieza por pieza.</p></div>
          </li>
          <li><span class="proceso-dot" aria-hidden="true"></span>
            <div class="proceso-card" tabindex="0"><b>3 · Te lo enviamos</b>
              <p>Por Andreani llega en 2 a 4 días hábiles. Si lo mandamos en moto o por Uber paquetería, te llega en el día.</p></div>
          </li>
        </ol>
      </section>

      <div id="resenas">
        <details open><summary>¿Qué incluye?</summary><p>Todo incluido: el Midori armado con el elástico que elijas. Admite hasta 6 cuadernos (6 elásticos = 6 cuadernos).</p></details>
        <details><summary>Materiales y cuidado</summary><p>Cuero natural: cada pieza es única y puede variar en tono y veta. Con el uso se oscurece y gana carácter.</p></details>
        <details><summary>Producción y envío</summary><p>Personalizado: 5-7 días hábiles de producción y después el envío. Selección clásica: se despacha en 2 días hábiles o menos.</p></details>
        <details><summary>Preguntas frecuentes</summary><p>¿Va a quedar como en la vista previa? La vista previa muestra tus elecciones; el cuero natural puede variar levemente en tono y veta.</p></details>
      </div>
    </section>
  </div>

  <div class="trust" aria-label="Por qué Vallorani">
    <div><svg class="i ic"><use href="#i-leaf"/></svg><span><b>Cuero natural</b><small>Cada pieza es única</small></span></div>
    <div><svg class="i ic"><use href="#i-needle"/></svg><span><b>Hecho a mano</b><small>Uno por uno</small></span></div>
    <div><svg class="i ic"><use href="#i-box"/></svg><span><b>Todo incluido</b><small>Sin sorpresas al pagar</small></span></div>
    <div><svg class="i ic"><use href="#i-pen"/></svg><span><b>Grabado a pedido</b><small>Tu nombre, tu inicial</small></span></div>
  </div>
</div>

<div class="sticky" id="sticky"><div class="price">Desde <s>{{ custom_list | money_without_trailing_zeros }}</s><b>{{ custom_pay | money_without_trailing_zeros }}</b><small>{{ transfer_off }}% off con transferencia</small></div><a class="btn solid" href="{{ customizer_url }}">Personalizar <svg class="i"><use href="#i-arrow"/></svg></a></div>
</div>

<script src="{{ 'midori-pre-compra.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Midori · Pre-compra",
  "tag": "section",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    { "type": "header", "content": "Producto" },
    { "type": "text", "id": "model", "label": "Medida (se muestra en el título)", "default": "A5" },
    { "type": "text", "id": "subtitle", "label": "Subtítulo", "default": "Un cuaderno para llevar a todas partes" },
    {
      "type": "product",
      "id": "price_product",
      "label": "Producto del que sale el precio",
      "info": "Si lo dejás vacío se usa el producto de esta página."
    },
    { "type": "header", "content": "Precios" },
    { "type": "range", "id": "classic_discount", "label": "Selección clásica: % menos que el diseño a tu medida", "min": 0, "max": 50, "step": 1, "unit": "%", "default": 20 },
    { "type": "range", "id": "transfer_discount", "label": "Descuento por transferencia", "min": 0, "max": 30, "step": 1, "unit": "%", "default": 10 },
    { "type": "header", "content": "Botones" },
    {
      "type": "url",
      "id": "customizer_url",
      "label": "Botón Personalizar",
      "info": "Vacío = abre el customizador de este producto (?view=journal)."
    },
    { "type": "url", "id": "classic_url", "label": "Botón Ver selección" },
    { "type": "url", "id": "crumb_url", "label": "Enlace de “Midoris” en la ruta" },
    { "type": "header", "content": "Reseñas" },
    { "type": "paragraph", "content": "Puntaje y cantidad se leen solos de Judge.me; estos valores son el respaldo." },
    { "type": "text", "id": "rating", "label": "Puntaje (respaldo)", "default": "5,0" },
    { "type": "text", "id": "review_count", "label": "Cantidad de reseñas (respaldo)", "default": "27" },
    { "type": "textarea", "id": "review_quote", "label": "Reseña destacada (texto real de una clienta)", "default": "Muy linda, muy buena calidad, tiene detalles, me encantó!" },
    { "type": "text", "id": "review_author", "label": "Nombre", "default": "Maria Florencia S." },
    { "type": "text", "id": "review_caption", "label": "Descripción", "default": "Una clienta de Vallorani" }
  ],
  "blocks": [
    {
      "type": "cuero",
      "name": "Foto de cuero",
