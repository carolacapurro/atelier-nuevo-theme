{%- comment -%} Bloque '¡Hacemos envíos a todo el mundo!' (va debajo de la postal en la pre-tienda y en el home). uid: id único {%- endcomment -%}
<section class="envm" id="envm-{{ uid }}" aria-labelledby="envm-t-{{ uid }}">
    <div class="env-art">
      <svg viewBox="0 0 520 520" role="img" aria-label="Caja de Vallorani abierta con monumentos del mundo">
