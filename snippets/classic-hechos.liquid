{%- comment -%} Classic: fotos reales del Midori en el cuero de este producto (mismo estilo que "Mirá Midoris ya hechos" del personalizador). El cuero sale de la etiqueta del producto. {%- endcomment -%}
{%- liquid
  assign cuero = ''
  for t in product.tags
    if t != 'seleccion-clasica'
      assign cuero = t
    endif
  endfor
  assign h = cuero | handleize
-%}
{%- if h != blank -%}
<div class="ch-hechos" id="ch-hechos-{{ product.id }}">
  <button type="button" class="ch-toggle" aria-expanded="false" aria-controls="ch-strip-{{ product.id }}">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 8h3l2-2.5h6L17 8h3v11H4z"/><circle cx="12" cy="13" r="3.5"/></svg>
    <span>Mirá Midoris ya hechos en {{ cuero }}</span>
    <svg class="chev" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9.5l6 6 6-6" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
  </button>
  <div class="ch-strip" id="ch-strip-{{ product.id }}" hidden>
    {%- assign sufijos = ',-2,-3,-4' | split: ',' -%}
    {%- for s in sufijos -%}
      {%- assign f = 'midori-' | append: h | append: s | append: '.jpg' -%}
      <button type="button" class="ch-foto"><img src="{{ f | asset_url }}" alt="Midori real en cuero {{ cuero | escape }}" loading="lazy" onerror="this.closest('.ch-foto').remove()"></button>
    {%- endfor -%}
  </div>
  <dialog class="ch-visor"><button type="button" class="ch-cerrar" aria-label="Cerrar">×</button><img alt=""></dialog>
</div>
<style>
  .ch-hechos{margin:10px 0 4px; text-align:center;}
  .ch-toggle{display:inline-flex; align-items:center; gap:10px; background:none; border:0; padding:6px 4px; cursor:pointer; font-family:"Montserrat","Helvetica Neue",Arial,sans-serif; font-size:11.5px; font-weight:600; letter-spacing:.12em; text-transform:uppercase; color:#7b1923;}
  .ch-toggle svg{width:18px; height:18px; flex:none;}
  .ch-toggle .chev{width:14px; height:14px; transition:transform .2s ease;}
  .ch-toggle[aria-expanded="true"] .chev{transform:rotate(180deg);}
  .ch-toggle span{border-bottom:1.5px solid currentColor; padding-bottom:2px;}
  .ch-strip{display:flex; justify-content:center; gap:10px; overflow-x:auto; padding:12px 2px 6px;}
  .ch-strip[hidden]{display:none;}
  .ch-foto{flex:0 0 auto; background:none; border:0; padding:0; cursor:zoom-in;}
  .ch-foto img{display:block; width:120px; height:154px; object-fit:cover; border-radius:6px; border:2px solid transparent; transition:border-color .15s ease, transform .15s ease;}
  .ch-foto:hover img{border-color:#7b1923; transform:translateY(-2px);}
  .ch-visor{border:0; padding:0; background:transparent; max-width:min(92vw,720px);}
  .ch-visor::backdrop{background:rgba(20,10,10,.75);}
  .ch-visor img{display:block; width:100%; max-height:86vh; object-fit:contain; border-radius:10px;}
  .ch-cerrar{position:absolute; top:8px; right:10px; width:36px; height:36px; border-radius:50%; border:0; background:#fffff7; color:#7b1923; font-size:22px; line-height:1; cursor:pointer;}
</style>
<script>
(function(){
  var w=document.getElementById('ch-hechos-{{ product.id }}'); if(!w) return;
  var t=w.querySelector('.ch-toggle'), s=w.querySelector('.ch-strip'), v=w.querySelector('.ch-visor');
  t.addEventListener('click',function(){ var o=t.getAttribute('aria-expanded')!=='true'; t.setAttribute('aria-expanded',o); s.hidden=!o; });
  s.addEventListener('click',function(e){ var b=e.target.closest('.ch-foto'); if(!b) return; v.querySelector('img').src=b.querySelector('img').src; v.showModal(); });
  v.addEventListener('click',function(e){ if(e.target===v||e.target.closest('.ch-cerrar')) v.close(); });
})();
</script>
{%- endif -%}
{%- comment -%} A6 = 4 elásticos: al elegir A6 la foto principal cambia a la versión A6 (assets/clasica-<handle>-a6.jpg) {%- endcomment -%}
<script>
(function(){
  var a6 = {{ 'clasica-' | append: product.handle | append: '-a6.jpg' | asset_url | json }};
  function imgs(){ return [...document.querySelectorAll('.product-information img.product-media__image, media-gallery img')].filter(function(i){ return /clasica-/.test(i.getAttribute('src') || '') || i.dataset.a5; }); }
  function tam(){ var c = document.querySelector('.product-information input[type=radio][value="A6"]:checked, input[type=radio][value="A6"]:checked'); return c ? 'A6' : 'A5'; }
  function aplicar(){
    var t = tam();
    imgs().forEach(function(i){
      if (!i.dataset.a5) { i.dataset.a5 = i.getAttribute('src'); i.dataset.a5set = i.getAttribute('srcset') || ''; }
      if (t === 'A6') { if (i.getAttribute('src') !== a6) { i.removeAttribute('srcset'); i.setAttribute('src', a6); } }
      else if (i.getAttribute('src') === a6) { i.setAttribute('src', i.dataset.a5); if (i.dataset.a5set) i.setAttribute('srcset', i.dataset.a5set); }
    });
  }
  var pend = false;
  function pedir(){ if (pend) return; pend = true; requestAnimationFrame(function(){ pend = false; aplicar(); }); }
  document.addEventListener('click', function(){ setTimeout(aplicar, 50); setTimeout(aplicar, 500); }, true);
  new MutationObserver(pedir).observe(document.documentElement, { childList: true, subtree: true });
  if (document.readyState !== 'loading') aplicar(); else document.addEventListener('DOMContentLoaded', aplicar);
})();
</script>
